      "source": [
        "import pandas as pd\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.naive_bayes import GaussianNB\n",
        "from sklearn.metrics import accuracy_score, confusion_matrix\n",
        "\n",
        "data = pd.DataFrame({\n",
        "    'Age': [25,30,35,40,45,28,32,38,50,55],\n",
        "    'Income': [25000,35000,50000,60000,80000,\n",
        "               30000,45000,55000,90000,100000],\n",
        "    'LoanAmount': [100000,150000,200000,250000,300000,\n",
        "                   120000,180000,220000,250000,200000],\n",
        "    'CreditScore': [600,620,680,700,750,\n",
        "                    610,670,690,780,800],\n",
        "    'LoanApproved': [\n",
        "        0,0,1,1,1,\n",
        "        0,1,1,1,1\n",
        "    ]\n",
        "})\n",
        "\n",
        "X = data.drop('LoanApproved', axis=1)\n",
        "y = data['LoanApproved']\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X, y,\n",
        "    test_size=0.3,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "model = GaussianNB()\n",
        "\n",
        "model.fit(X_train, y_train)\n",
        "\n",
        "y_pred = model.predict(X_test)\n",
        "\n",
        "print(\"Predicted:\", y_pred)\n",
        "\n",
        "print(\"\\nActual:\", y_test.values)\n",
        "\n",
        "print(\"\\nAccuracy:\",\n",
        "      accuracy_score(y_test, y_pred))\n",
        "\n",
        "print(\"\\nConfusion Matrix:\")\n",
        "print(confusion_matrix(y_test, y_pred))\n",
        "\n",
        "# New customer\n",
        "new_customer = [[35, 55000, 200000, 700]]\n",
        "\n",
        "prediction = model.predict(new_customer)\n",
        "\n",
        "if prediction[0] == 1:\n",
        "    print(\"\\nLoan Approved\")\n",
        "else:\n",
        "    print(\"\\nLoan Not Approved\")"
      ],
