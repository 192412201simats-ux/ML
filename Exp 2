      "source": [
        "import pandas as pd\n",
        "\n",
        "# Example dataset (you can replace with your own CSV)\n",
        "data = [\n",
        "    ['Sunny','Warm','Normal','Strong','Warm','Same','Yes'],\n",
        "    ['Sunny','Warm','High','Strong','Warm','Same','Yes'],\n",
        "    ['Rainy','Cold','High','Strong','Warm','Change','No'],\n",
        "    ['Sunny','Warm','High','Strong','Cool','Change','Yes']\n",
        "]\n",
        "\n",
        "df = pd.DataFrame(data, columns=['Sky','AirTemp','Humidity','Wind','Water','Forecast','EnjoySport'])\n",
        "\n",
        "# Candidate-Elimination Algorithm\n",
        "def candidate_elimination(df):\n",
        "    # Initialize specific hypothesis\n",
        "    specific_h = df.iloc[0,:-1].tolist()\n",
        "    # Initialize general hypothesis\n",
        "    general_h = [['?' for _ in range(len(specific_h))]]\n",
        "\n",
        "    for i in range(len(df)):\n",
        "        instance = df.iloc[i,:-1].tolist()\n",
        "        label = df.iloc[i,-1]\n",
        "\n",
        "        if label == 'Yes':  # Positive example\n",
        "            for j in range(len(specific_h)):\n",
        "                if specific_h[j] != instance[j]:\n",
        "                    specific_h[j] = '?'\n",
        "            # Remove inconsistent general hypotheses\n",
        "            general_h = [g for g in general_h if all(\n",
        "                g[k] == '?' or g[k] == instance[k] or specific_h[k] == '?' for k in range(len(specific_h))\n",
        "            )]\n",
        "        else:  # Negative example\n",
        "            new_general = []\n",
        "            for j in range(len(specific_h)):\n",
        "                if specific_h[j] == '?':\n",
        "                    continue\n",
        "                if specific_h[j] != instance[j]:\n",
        "                    h = ['?' for _ in range(len(specific_h))]\n",
        "                    h[j] = specific_h[j]\n",
        "                    new_general.append(h)\n",
        "            general_h.extend(new_general)\n",
        "\n",
        "    return specific_h, general_h\n",
        "\n",
        "specific, general = candidate_elimination(df)\n",
        "print(\"Final Specific Hypothesis:\", specific)\n",
        "print(\"Final General Hypotheses:\", general)\n"
      ],
